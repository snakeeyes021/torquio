<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>tech.redfoxlabs.Torquio</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Torquio</name>
  <summary>Run Dorico on Linux</summary>
  <description>
    <p>
      Torquio installs and runs Steinberg's Dorico, with its Activation Manager, Download Assistant and
      playback plug-ins such as NotePerformer and Cantai, in a Wine environment tuned for it. It takes care of
      display scaling, file associations, sign-in links and updates.
    </p>
    <p>
      Dorico and Steinberg's other software aren't included: you download them with your own Steinberg
      account.
    </p>
    <p>
      Torquio is an independent project, not affiliated with or endorsed by Steinberg Media Technologies GmbH.
      Dorico is a trademark of Steinberg.
    </p>
  </description>

  <developer id="tech.redfoxlabs">
    <name>Matthew Samson (Red Fox Labs)</name>
  </developer>

  <url type="homepage">https://github.com/snakeeyes021/torquio</url>
  <url type="vcs-browser">https://github.com/snakeeyes021/torquio</url>
  <url type="bugtracker">https://github.com/snakeeyes021/torquio/issues</url>

  <translation type="gettext">torquio-gui</translation>
  <launchable type="desktop-id">tech.redfoxlabs.Torquio.desktop</launchable>
  <content_rating type="oars-1.1" />

  <!-- Taken in a test VM (gui/data/screenshots/); the URLs point at the release's tag -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/snakeeyes021/torquio/v0.7.0-alpha/gui/data/screenshots/overview.png</image>
      <caption>Dorico, the Activation Manager and the Download Assistant one click away</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/snakeeyes021/torquio/v0.7.0-alpha/gui/data/screenshots/display.png</image>
      <caption>Display scaling for Dorico, automatic or by hand</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/snakeeyes021/torquio/v0.7.0-alpha/gui/data/screenshots/plugins.png</image>
      <caption>The GPU AI plug-ins such as Cantai render on</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/snakeeyes021/torquio/v0.7.0-alpha/gui/data/screenshots/maintenance.png</image>
      <caption>Wine's tools, repairs, engine updates and logs</caption>
    </screenshot>
  </screenshots>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <releases>
    <release version="0.7.0" date="2026-11-04">
      <description translate="no">
        <p>The first release of Torquio's app: everything the torquio menu does, in a window.</p>
        <ul>
          <li>A setup assistant that checks what's needed, finds your installers and installs Torquio</li>
          <li>Dorico, the Activation Manager and the Download Assistant one click away</li>
          <li>Display scaling, folders, key commands and the GPU for AI plug-ins</li>
          <li>Wine's tools, repairs, engine updates, logs for bug reports, and uninstalling</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
