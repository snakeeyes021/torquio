+/* Sum of change counters of everything that do_composite() would draw for this visual. */
+static ULONGLONG visual_content_version(struct composition_visual *visual, int depth)
+{
+    struct composition_visual *child;
+    ULONGLONG version = 0;
+
+    if (depth > 32)
+        return 0;
+
+    if (visual->shared_visual_handle)
+    {
+        struct composition_visual *root = shared_visual_target_get_root(visual->shared_visual_handle);
+        if (root)
+            version += visual_content_version(root, depth + 1);
+    }
+
+    if (visual->content)
+    {
+        if (IsEqualGUID(&visual->content_iid, &IID_IDXGISwapChain1))
+        {
+            IDXGISwapChain1 *swapchain;
+            UINT count;
+
+            if (SUCCEEDED(IUnknown_QueryInterface(visual->content, &IID_IDXGISwapChain1, (void **)&swapchain)))
+            {
+                if (SUCCEEDED(IDXGISwapChain1_GetLastPresentCount(swapchain, &count)))
+                    version += count;
+                IDXGISwapChain1_Release(swapchain);
+            }
+        }
+        else if (IsEqualGUID(&visual->content_iid, &IID_IDCompositionSurface))
+        {
+            IDCompositionSurface *surface;
+
+            if (SUCCEEDED(IUnknown_QueryInterface(visual->content, &IID_IDCompositionSurface, (void **)&surface)))
+            {
+                struct composition_surface *surface_impl = impl_from_IDCompositionSurface(surface);
+                if (surface_impl)
+                    version += surface_impl->draw_count;
+                IDCompositionSurface_Release(surface);
+            }
+        }
+    }
+
+    LIST_FOR_EACH_ENTRY(child, &visual->child_visuals, struct composition_visual, entry)
+        version += visual_content_version(child, depth + 1);
+
+    return version;
+}
+
+/* Whether the target needs to be composed this pass. */
+static BOOL target_needs_composite(struct composition_device *device, struct composition_target *target,
+        struct composition_visual *visual)
+{
+    ULONGLONG version = visual_content_version(visual, 0) + device->commit_count;
+    BOOL visible = IsWindowVisible(target->hwnd);
+    RECT rect;
+
+    GetWindowRect(target->hwnd, &rect);
+    if (!target->composed || version != target->content_version || visible != target->visible
+            || !EqualRect(&rect, &target->window_rect))
+    {
+        target->content_version = version;
+        target->window_rect = rect;
+        target->visible = visible;
+        target->settle = 2;
+        return TRUE;
+    }
+    if (target->settle > 0)
+    {
+        target->settle--;
+        return TRUE;
+    }
+    return FALSE;
+}
