 }
 
+/* An attribute is stored as the value "Attribute<n>", REG_BINARY:
+ * DWORD flags, DWORD value size, keyword (WCHAR, nul-terminated), value bytes. */
+static DWORD read_credential_attributes(HKEY hkey, PCREDENTIALW credential, char **buffer, DWORD *len)
+{
+    DWORD i, ret, type, count, total = 0, keyword_len, value_size, flags;
+    CREDENTIAL_ATTRIBUTEW *attrs;
+    WCHAR name[32];
+    BYTE *data;
+
+    for (i = 0; ; i++)
+    {
+        swprintf(name, ARRAY_SIZE(name), L"Attribute%lu", i);
+        ret = RegQueryValueExW(hkey, name, 0, &type, NULL, &count);
+        if (ret == ERROR_FILE_NOT_FOUND) break;
+        if (ret != ERROR_SUCCESS) return ret;
+        if (type != REG_BINARY || count < 2 * sizeof(DWORD) + sizeof(WCHAR)) return ERROR_REGISTRY_CORRUPT;
+        total += count;
+    }
+    if (credential)
+    {
+        credential->AttributeCount = 0;
+        credential->Attributes = NULL;
+    }
+    if (!i) return ERROR_SUCCESS;
+
+    /* the attribute array (pointer-aligned), then each keyword and value */
+    *len += sizeof(void *) + i * sizeof(*attrs) + total;
+    if (!credential) return ERROR_SUCCESS;
+
+    attrs = (CREDENTIAL_ATTRIBUTEW *)(((UINT_PTR)*buffer + sizeof(void *) - 1) & ~(UINT_PTR)(sizeof(void *) - 1));
+    data = (BYTE *)(attrs + i);
+    credential->AttributeCount = i;
+    credential->Attributes = attrs;
+    for (i = 0; i < credential->AttributeCount; i++)
+    {
+        BYTE *rec = data;
+
+        swprintf(name, ARRAY_SIZE(name), L"Attribute%lu", i);
+        count = total;
+        ret = RegQueryValueExW(hkey, name, 0, &type, rec, &count);
+        if (ret != ERROR_SUCCESS) return ret;
+        if (type != REG_BINARY || count < 2 * sizeof(DWORD) + sizeof(WCHAR)) return ERROR_REGISTRY_CORRUPT;
+        memcpy(&flags, rec, sizeof(flags));
+        memcpy(&value_size, rec + sizeof(DWORD), sizeof(value_size));
+        if (value_size > count - 2 * sizeof(DWORD) - sizeof(WCHAR)) return ERROR_REGISTRY_CORRUPT;
+        keyword_len = count - 2 * sizeof(DWORD) - value_size;
+        attrs[i].Flags = flags;
+        attrs[i].Keyword = (WCHAR *)(rec + 2 * sizeof(DWORD));
+        attrs[i].Keyword[keyword_len / sizeof(WCHAR) - 1] = 0;
+        attrs[i].ValueSize = value_size;
+        attrs[i].Value = value_size ? rec + 2 * sizeof(DWORD) + keyword_len : NULL;
+        data += count;
+        total -= count;
+    }
+    *buffer = (char *)data;
+    return ERROR_SUCCESS;
+}
+
+static DWORD write_credential_attributes(HKEY hkey, const CREDENTIALW *credential)
+{
+    DWORD i, ret = ERROR_SUCCESS, keyword_size, size;
+    WCHAR name[32];
+    BYTE *rec;
+
+    for (i = 0; i < credential->AttributeCount; i++)
+    {
+        const CREDENTIAL_ATTRIBUTEW *attr = &credential->Attributes[i];
+
+        if (!attr->Keyword) return ERROR_INVALID_PARAMETER;
+        keyword_size = (lstrlenW(attr->Keyword) + 1) * sizeof(WCHAR);
+        size = 2 * sizeof(DWORD) + keyword_size + attr->ValueSize;
+        if (!(rec = malloc(size))) return ERROR_OUTOFMEMORY;
+        memcpy(rec, &attr->Flags, sizeof(DWORD));
+        memcpy(rec + sizeof(DWORD), &attr->ValueSize, sizeof(DWORD));
+        memcpy(rec + 2 * sizeof(DWORD), attr->Keyword, keyword_size);
+        if (attr->ValueSize) memcpy(rec + 2 * sizeof(DWORD) + keyword_size, attr->Value, attr->ValueSize);
+        swprintf(name, ARRAY_SIZE(name), L"Attribute%lu", i);
+        ret = RegSetValueExW(hkey, name, 0, REG_BINARY, rec, size);
+        free(rec);
+        if (ret != ERROR_SUCCESS) return ret;
+    }
+    /* drop attributes a previous write left behind */
+    for (;; i++)
+    {
+        swprintf(name, ARRAY_SIZE(name), L"Attribute%lu", i);
+        if (RegDeleteValueW(hkey, name) != ERROR_SUCCESS) break;
+    }
+    return ret;
+}
