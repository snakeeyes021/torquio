+
+/* Torquio: whether this process can run Direct3D 12 (and therefore DirectML) on this adapter.
+ * Only reported for a native d3d12.dll such as vkd3d-proton: DirectML on Wine's builtin d3d12 runs but
+ * computes wrong results (Cantai's vocoder produced fixed tones), so with the builtin one adapters keep
+ * reporting no Direct3D 12 support and machine-learning apps stay on the CPU, as before this patch.
+ * Checked once per adapter, without creating a device. */
+static BOOL dxcore_adapter_supports_d3d12(struct dxcore_adapter *adapter)
+{
+    static const char builtin_signature[] = "Wine builtin DLL";
+
+    if (adapter->d3d12_support < 0)
+    {
+        HRESULT (WINAPI *create_device)(IUnknown *, D3D_FEATURE_LEVEL, REFIID, void **) = NULL;
+        HMODULE d3d12 = LoadLibraryW(L"d3d12.dll");
+
+        adapter->d3d12_support = 0;
+        if (!d3d12)
+            WARN("d3d12.dll not available.\n");
+        else if (!memcmp((const char *)d3d12 + 0x40, builtin_signature, sizeof(builtin_signature) - 1))
+            TRACE("Wine's builtin d3d12 is in use; not reporting Direct3D 12 support.\n");
+        else if ((create_device = (void *)GetProcAddress(d3d12, "D3D12CreateDevice")))
+            adapter->d3d12_support = SUCCEEDED(create_device((IUnknown *)&adapter->IDXCoreAdapter_iface,
+                    D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, NULL));
+        TRACE("adapter %p, Direct3D 12 %ssupported.\n", adapter, adapter->d3d12_support ? "" : "not ");
+    }
+    return adapter->d3d12_support;
 }
 
 static BOOL STDMETHODCALLTYPE dxcore_adapter_IsAttributeSupported(IDXCoreAdapter *iface, REFGUID attribute)
 {
-    FIXME("iface %p, attribute %s stub!\n", iface, debugstr_guid(attribute));
+    struct dxcore_adapter *adapter = impl_from_IDXCoreAdapter(iface);
+
+    TRACE("iface %p, attribute %s.\n", iface, debugstr_guid(attribute));
+
+    if (IsEqualGUID(attribute, &dxcore_attribute_d3d11_graphics)
+            || IsEqualGUID(attribute, &dxcore_hardware_type_gpu))
+        return TRUE;
+    if (IsEqualGUID(attribute, &DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS)
+            || IsEqualGUID(attribute, &DXCORE_ADAPTER_ATTRIBUTE_D3D12_CORE_COMPUTE)
+            || IsEqualGUID(attribute, &dxcore_attribute_d3d12_generic_ml))
+        return dxcore_adapter_supports_d3d12(adapter);
+
+    FIXME("Unhandled attribute %s.\n", debugstr_guid(attribute));
     return FALSE;
 }
 
 static BOOL STDMETHODCALLTYPE dxcore_adapter_IsPropertySupported(IDXCoreAdapter *iface, DXCoreAdapterProperty property)
 {
-    FIXME("iface %p, property %u stub!\n", iface, property);
-    return FALSE;
+    TRACE("iface %p, property %u.\n", iface, property);
+
+    switch (property)
+    {
+        case InstanceLuid:
+        case DriverVersion:
+        case DriverDescription:
+        case HardwareID:
+        case IsHardware:
+            return TRUE;
+        default:
+            FIXME("Unhandled property %u.\n", property);
+            return FALSE;
+    }
 }
 
