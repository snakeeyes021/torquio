+    surface->IDCompositionVirtualSurface_iface.lpVtbl = &virtual_surface_vtbl;
+    surface->IDCompositionSurfaceUnknown_iface.lpVtbl = &surface_vtbl;
+    surface->is_virtual = TRUE;
