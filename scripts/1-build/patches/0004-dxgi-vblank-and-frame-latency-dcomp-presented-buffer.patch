+HRESULT d3d11_swapchain_init_frame_latency(struct d3d11_swapchain *swapchain, unsigned int dxgi_flags)
+{
+    if (!(dxgi_flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT))
+        return S_OK;
+
+    swapchain->frame_latency_waitable = TRUE;
+    swapchain->frame_latency = 1;
+    if (!(swapchain->frame_latency_semaphore = CreateSemaphoreW(NULL, swapchain->frame_latency, LONG_MAX, NULL)))
+    {
+        ERR("Failed to create frame latency semaphore, last error %lu.\n", GetLastError());
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+
+    return S_OK;
+}
