 static HRESULT STDMETHODCALLTYPE dxgi_output_WaitForVBlank(IDXGIOutput6 *iface)
 {
-    static BOOL once = FALSE;
+    struct dxgi_output *output = impl_from_IDXGIOutput6(iface);
+    enum wined3d_display_rotation rotation;
+    struct wined3d_display_mode mode;
+    unsigned int refresh_rate = 0;
+    LARGE_INTEGER freq, now;
+    ULONGLONG period, next;
+    DWORD ms;
 
-    if (!once++)
-        FIXME("iface %p stub!\n", iface);
-    else
-        TRACE("iface %p stub!\n", iface);
+    TRACE("iface %p.\n", iface);
 
-    return E_NOTIMPL;
+    /* We have no access to the real vertical blank, so emulate it with a
+     * clock aligned to the output refresh rate. Callers (e.g. Qt's vsync
+     * thread) expect this to block until the next frame; returning
+     * immediately makes them treat the output as broken. */
+    wined3d_mutex_lock();
+    if (SUCCEEDED(wined3d_output_get_display_mode(output->wined3d_output, &mode, &rotation)))
+        refresh_rate = mode.refresh_rate;
+    wined3d_mutex_unlock();
+    if (refresh_rate < 24 || refresh_rate > 500)
+        refresh_rate = 60;
+
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&now);
+    period = freq.QuadPart / refresh_rate;
+    next = (now.QuadPart / period + 1) * period;
+    ms = (next - now.QuadPart) * 1000 / freq.QuadPart;
+    if (ms < 2)
+        ms += 1000 / refresh_rate;
+    Sleep(ms);
+
+    return S_OK;
 }
 
