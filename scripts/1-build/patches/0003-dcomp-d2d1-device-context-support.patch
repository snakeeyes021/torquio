-    hr = IUnknown_QueryInterface(surface->draw_surface, iid, object);
-    if (FAILED(hr))
-        return hr;
+    if (IsEqualGUID(iid, &IID_ID2D1DeviceContext))
+    {
+        ID2D1Device *d2d_device = NULL;
+        IDXGISurface *dxgi_surface = NULL;
+        D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+
+        /* Get or create the ID2D1Device */
+        hr = IUnknown_QueryInterface(factory->rendering_device, &IID_ID2D1Device, (void **)&d2d_device);
+        if (FAILED(hr))
+        {
+            IDXGIDevice *dxgi_dev = get_dxgi_device_from_factory(factory);
+            if (dxgi_dev)
+            {
+                hr = D2D1CreateDevice(dxgi_dev, NULL, &d2d_device);
+                IDXGIDevice_Release(dxgi_dev);
+            }
+            if (FAILED(hr) || !d2d_device)
+            {
+                ERR("Failed to get or create ID2D1Device, hr %#lx.\n", hr);
+                return hr ? hr : E_FAIL;
+            }
+        }
+
+        /* Create the device context */
+        hr = ID2D1Device_CreateDeviceContext(d2d_device, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &surface->d2d_context);
+        ID2D1Device_Release(d2d_device);
+        if (FAILED(hr))
+        {
+            ERR("Failed to create ID2D1DeviceContext, hr %#lx.\n", hr);
+            return hr;
+        }
+
+        /* Get the DXGI surface from the draw texture */
+        hr = ID3D11Texture2D_QueryInterface(surface->draw_surface, &IID_IDXGISurface, (void **)&dxgi_surface);
+        if (FAILED(hr))
+        {
+            ERR("Failed to get IDXGISurface from draw texture, hr %#lx.\n", hr);
+            ID2D1DeviceContext_Release(surface->d2d_context);
+            surface->d2d_context = NULL;
+            return hr;
+        }
+
+        /* Create a target bitmap from the DXGI surface */
+        memset(&bitmap_desc, 0, sizeof(bitmap_desc));
+        bitmap_desc.pixelFormat.format = surface->pixel_format;
+        bitmap_desc.pixelFormat.alphaMode = surface->alpha_mode == DXGI_ALPHA_MODE_PREMULTIPLIED
+                ? D2D1_ALPHA_MODE_PREMULTIPLIED : D2D1_ALPHA_MODE_IGNORE;
+        bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET | D2D1_BITMAP_OPTIONS_CANNOT_DRAW;
+
+        hr = ID2D1DeviceContext_CreateBitmapFromDxgiSurface(surface->d2d_context, dxgi_surface,
+                &bitmap_desc, &surface->d2d_target_bitmap);
+        IDXGISurface_Release(dxgi_surface);
+        if (FAILED(hr))
+        {
+            ERR("Failed to create bitmap from DXGI surface, hr %#lx.\n", hr);
+            ID2D1DeviceContext_Release(surface->d2d_context);
+            surface->d2d_context = NULL;
+            return hr;
+        }
+
+        /* Set the bitmap as the render target and begin drawing */
+        ID2D1DeviceContext_SetTarget(surface->d2d_context, (ID2D1Image *)surface->d2d_target_bitmap);
+        ID2D1DeviceContext_BeginDraw(surface->d2d_context);
+
+        *object = surface->d2d_context;
+        ID2D1DeviceContext_AddRef(surface->d2d_context);
+    }
+    else
+    {
+        hr = IUnknown_QueryInterface(surface->draw_surface, iid, object);
+        if (FAILED(hr))
+            return hr;
+    }
 
     offset->x = rect->left;
