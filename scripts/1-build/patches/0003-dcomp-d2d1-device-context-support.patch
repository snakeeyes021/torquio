+        d2d_hr = ID2D1DeviceContext_EndDraw(surface->d2d_context, NULL, NULL);
+        if (FAILED(d2d_hr))
+            WARN("ID2D1DeviceContext_EndDraw failed, hr %#lx.\n", d2d_hr);
+
+        ID2D1DeviceContext_SetTarget(surface->d2d_context, NULL);
+        if (surface->d2d_target_bitmap)
+        {
+            ID2D1Bitmap1_Release(surface->d2d_target_bitmap);
+            surface->d2d_target_bitmap = NULL;
+        }
+        ID2D1DeviceContext_Release(surface->d2d_context);
+        surface->d2d_context = NULL;
+    }
+
     /* TODO: Copy data after Commit() is called instead of doing it immediately here */
 
     dxgi_device = get_dxgi_device_from_factory(factory);
