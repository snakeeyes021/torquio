+static void target_update_region(struct composition_target *target, HDC src_dc, UINT width, UINT height)
+{
+    HBITMAP bitmap = GetCurrentObject(src_dc, OBJ_BITMAP);
+    POINT origin = {0, 0};
+    RECT *rects;
+    UINT x, y, count = 0;
+    DIBSECTION dib;
+
+    if (!bitmap || GetObjectW(bitmap, sizeof(dib), &dib) != sizeof(dib) || !dib.dsBm.bmBits
+            || dib.dsBm.bmBitsPixel != 32)
+        return;
+    width = min(width, dib.dsBm.bmWidth);
+    height = min(height, dib.dsBm.bmHeight);
+    if (!(rects = malloc(max(height, 1) * sizeof(*rects))))
+        return;
+
+    for (y = 0; y < height; ++y)
+    {
+        UINT row_index = dib.dsBmih.biHeight > 0 ? dib.dsBm.bmHeight - 1 - y : y;
+        const DWORD *row = (const DWORD *)((const BYTE *)dib.dsBm.bmBits + row_index * dib.dsBm.bmWidthBytes);
+        int left = -1, right = -1;
+
+        for (x = 0; x < width; ++x)
+        {
+            if (row[x] >> 24)
+            {
+                left = x;
+                break;
+            }
+        }
+        if (left < 0)
+            continue;
+        for (x = width; x > left; --x)
+        {
+            if (row[x - 1] >> 24)
+            {
+                right = x;
+                break;
+            }
+        }
+
+        if (count && rects[count - 1].bottom == origin.y + y && rects[count - 1].left == origin.x + left
+                && rects[count - 1].right == origin.x + right)
+            ++rects[count - 1].bottom;
+        else
+            SetRect(&rects[count++], origin.x + left, origin.y + y, origin.x + right, origin.y + y + 1);
+    }
+
+    if (target->region_applied && count == target->region_count
+            && (!count || !memcmp(rects, target->region_rects, count * sizeof(*rects))))
+    {
+        free(rects);
+        return;
+    }
+    free(target->region_rects);
+    target->region_rects = rects;
+    target->region_count = count;
+    target->region_dirty = TRUE;
+}
