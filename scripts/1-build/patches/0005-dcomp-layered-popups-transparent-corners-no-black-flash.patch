+/* Record, for each row of the frame, the span of pixels that aren't fully transparent.
+ * X11 windows have no alpha channel, so those pixels are cut out with a window region. */
+/* Only cut layered windows without a non-client area (e.g. popups); windows may also stop
+ * being layered after the target was created. */
+static BOOL target_wants_region(struct composition_target *target)
+{
+    RECT window_rect, client_rect;
+    POINT origin = {0, 0};
+
+    if (!target->layered || !(GetWindowLongW(target->hwnd, GWL_EXSTYLE) & WS_EX_LAYERED))
+        return FALSE;
+    if (!GetWindowRect(target->hwnd, &window_rect) || !GetClientRect(target->hwnd, &client_rect)
+            || !ClientToScreen(target->hwnd, &origin))
+        return FALSE;
+    return origin.x == window_rect.left && origin.y == window_rect.top
+            && client_rect.right == window_rect.right - window_rect.left
+            && client_rect.bottom == window_rect.bottom - window_rect.top;
+}
+
+static void target_clear_region(struct composition_target *target)
+{
+    if (!target->region_applied)
