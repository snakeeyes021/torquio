+void target_show(struct composition_target *target)
+{
+    if (!target->hidden)
+        return;
+    target->hidden = FALSE;
+    SetLayeredWindowAttributes(target->hwnd, target->saved_key, target->saved_alpha,
+            target->saved_flags ? target->saved_flags : LWA_ALPHA);
+}
