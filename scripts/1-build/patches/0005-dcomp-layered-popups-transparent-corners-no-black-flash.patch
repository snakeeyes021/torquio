+/* Window updates that may send messages to the window's thread; they are applied after
+ * releasing the dcomp lock so that the composition thread can't deadlock with it. */
+struct window_update
+{
+    HWND hwnd;
+    HRGN region;
+    BOOL clear_region;
+    BOOL show;
+    COLORREF key;
+    BYTE alpha;
+    DWORD flags;
+};
+
+static void queue_window_update(struct composition_target *target, struct window_update **updates,
+        unsigned int *count, unsigned int *capacity)
+{
+    struct window_update *update;
+    RGNDATA *data;
+    BOOL show;
+
+    /* Show the window once its first frame is in place, or after a while if the
+     * application never provides one. */
+    show = target->hidden && (target->content_drawn || GetTickCount() - target->hidden_time > 2000);
+    if (!target->region_dirty && !show)
+        return;
+
+    if (*count == *capacity)
+    {
+        unsigned int new_capacity = max(8, *capacity * 2);
+        struct window_update *new_updates;
+
+        if (!(new_updates = realloc(*updates, new_capacity * sizeof(**updates))))
+            return;
+        *updates = new_updates;
+        *capacity = new_capacity;
+    }
+    update = &(*updates)[(*count)++];
+    memset(update, 0, sizeof(*update));
+    update->hwnd = target->hwnd;
+
+    if (target->region_dirty && !target->region_rects)
+    {
+        /* Region no longer wanted: remove it from the window. */
+        target->region_dirty = FALSE;
+        target->region_applied = FALSE;
+        update->clear_region = TRUE;
+    }
+    else if (target->region_dirty)
+    {
+        target->region_dirty = FALSE;
+        target->region_applied = TRUE;
+        if ((data = malloc(sizeof(data->rdh) + target->region_count * sizeof(RECT))))
+        {
+            data->rdh.dwSize = sizeof(data->rdh);
+            data->rdh.iType = RDH_RECTANGLES;
+            data->rdh.nCount = target->region_count;
+            data->rdh.nRgnSize = target->region_count * sizeof(RECT);
+            SetRectEmpty(&data->rdh.rcBound);
+            memcpy(data->Buffer, target->region_rects, target->region_count * sizeof(RECT));
+            update->region = ExtCreateRegion(NULL, sizeof(data->rdh) + data->rdh.nRgnSize, data);
+            free(data);
+        }
+    }
+
+    if (show)
+    {
+        target->hidden = FALSE;
+        update->show = TRUE;
+        update->key = target->saved_key;
+        update->alpha = target->saved_alpha;
+        update->flags = target->saved_flags ? target->saved_flags : LWA_ALPHA;
+    }
+}
