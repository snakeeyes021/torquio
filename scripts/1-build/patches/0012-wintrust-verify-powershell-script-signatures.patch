+/* A PowerShell script's digest is of its text, as UTF-16LE, up to its signature block. */
+static BOOL SOFTPUB_HashScript(CRYPT_PROVIDER_DATA *data, HANDLE file, HCRYPTHASH hash)
+{
+    const WCHAR *sig;
+    WCHAR *text;
+    DWORD len;
+    BOOL ret;
+
+    if (!(text = WINTRUST_ReadScript(file, data->pWintrustData->pFile->pcwszFilePath, &len)))
+        return FALSE;
+    if ((sig = WINTRUST_ScriptSignature(text))) len = sig - text;
+    ret = CryptHashData(hash, (BYTE *)text, len * sizeof(WCHAR), 0);
+    free(text);
+    return ret;
+}
