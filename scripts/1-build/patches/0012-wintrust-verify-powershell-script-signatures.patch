+/* The PowerShell SIP (pwrshsip.dll on Windows): a script's signature is a base64 PKCS #7 message in comment
+ * lines at its end ("# SIG # Begin signature block" ... "# SIG # End signature block"), and the signed digest
+ * is of the script's text, as UTF-16LE, up to the line break that starts the block. */
+const GUID WINTRUST_PowerShellSIP = { 0x603BCC1F, 0x4B59, 0x4E08, { 0xB7,0x24,0xD2,0xC6,0x29,0x7E,0xF3,0x51 }};
+static const WCHAR script_sig_begin[] = L"\r\n# SIG # Begin signature block\r\n";
+static const WCHAR script_sig_end[] = L"# SIG # End signature block";
+
+/* A script's text as UTF-16 (UTF-16 or UTF-8 with a byte order mark; without one, UTF-8 if it's valid UTF-8,
+ * else the ANSI code page), NUL-terminated; free() it. NULL on failure. */
+WCHAR *WINTRUST_ReadScript(HANDLE file, const WCHAR *name, DWORD *len)
+{
+    LARGE_INTEGER size;
+    BYTE *raw = NULL, *p;
+    WCHAR *text = NULL;
+    DWORD read, n, i;
+    BOOL opened = FALSE;
+    UINT cp;
+
+    if (!file || file == INVALID_HANDLE_VALUE)
+    {
+        file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+        if (file == INVALID_HANDLE_VALUE) return NULL;
+        opened = TRUE;
+    }
+    if (!GetFileSizeEx(file, &size) || size.QuadPart > 64 * 1024 * 1024) goto done;
+    if (!(raw = malloc(size.LowPart + 1))) goto done;
+    SetFilePointer(file, 0, NULL, FILE_BEGIN);
+    if (!ReadFile(file, raw, size.LowPart, &read, NULL) || read != size.LowPart) goto done;
+
+    if (read >= 2 && raw[0] == 0xff && raw[1] == 0xfe)
+    {
+        n = (read - 2) / sizeof(WCHAR);
+        if ((text = malloc((n + 1) * sizeof(WCHAR)))) memcpy(text, raw + 2, n * sizeof(WCHAR));
+    }
+    else if (read >= 2 && raw[0] == 0xfe && raw[1] == 0xff)
+    {
+        n = (read - 2) / sizeof(WCHAR);
+        if ((text = malloc((n + 1) * sizeof(WCHAR))))
+            for (i = 0; i < n; i++) text[i] = raw[2 + 2 * i] << 8 | raw[3 + 2 * i];
+    }
+    else
+    {
+        p = raw;
+        n = read;
+        cp = CP_UTF8;
+        if (n >= 3 && p[0] == 0xef && p[1] == 0xbb && p[2] == 0xbf)
+        {
+            p += 3;
+            n -= 3;
+        }
+        else if (n && !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (char *)p, n, NULL, 0))
+            cp = CP_ACP;
+        read = n;
+        n = read ? MultiByteToWideChar(cp, 0, (char *)p, read, NULL, 0) : 0;
+        if ((text = malloc((n + 1) * sizeof(WCHAR)))) MultiByteToWideChar(cp, 0, (char *)p, read, text, n);
+    }
+    if (text)
+    {
+        text[n] = 0;
+        *len = n;
+    }
+done:
+    free(raw);
+    if (opened) CloseHandle(file);
+    return text;
+}
+
+/* Where a script's signature block starts (the last one: it's at the end), or NULL. */
+const WCHAR *WINTRUST_ScriptSignature(const WCHAR *text)
+{
+    const WCHAR *found = NULL, *p = text;
+
+    while ((p = wcsstr(p, script_sig_begin))) found = p++;
+    return found;
+}
+
+static BOOL WINTRUST_GetSignedMsgFromScript(SIP_SUBJECTINFO *pSubjectInfo, DWORD *pdwEncodingType,
+ DWORD dwIndex, DWORD *pcbSignedDataMsg, BYTE *pbSignedDataMsg)
+{
+    const WCHAR *begin, *end, *line, *eol, *c;
+    WCHAR *text, *b64 = NULL, *dst;
+    DWORD len, size = 0;
+    BOOL ret = FALSE;
+
+    TRACE("(%p %p %ld %p %p)\n", pSubjectInfo, pdwEncodingType, dwIndex, pcbSignedDataMsg, pbSignedDataMsg);
+
+    if (!pcbSignedDataMsg)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(text = WINTRUST_ReadScript(pSubjectInfo->hFile, pSubjectInfo->pwsFileName, &len)))
+        return FALSE;
+    if (dwIndex || !(begin = WINTRUST_ScriptSignature(text)) || !(end = wcsstr(begin, script_sig_end)))
+    {
+        SetLastError(TRUST_E_NOSIGNATURE);
+        goto done;
+    }
+    /* The base64 data: the comment lines between the markers, without their "# " */
+    if (!(b64 = dst = malloc((end - begin + 1) * sizeof(WCHAR)))) goto done;
+    for (line = begin + wcslen(script_sig_begin); line < end; line = eol + 1)
+    {
+        if (!(eol = wcschr(line, '\n')) || eol > end) eol = end;
+        if (line[0] == '#' && line[1] == ' ')
+            for (c = line + 2; c < eol; c++)
+                if (*c != '\r') *dst++ = *c;
+        if (eol == end) break;
+    }
+    *dst = 0;
+    if (!CryptStringToBinaryW(b64, dst - b64, CRYPT_STRING_BASE64, NULL, &size, NULL, NULL))
+        SetLastError(TRUST_E_NOSIGNATURE);
+    else if (!pbSignedDataMsg)
+    {
+        *pcbSignedDataMsg = size;
+        ret = TRUE;
+    }
+    else if (*pcbSignedDataMsg < size)
+    {
+        *pcbSignedDataMsg = size;
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+    }
+    else
+        ret = CryptStringToBinaryW(b64, dst - b64, CRYPT_STRING_BASE64, pbSignedDataMsg, pcbSignedDataMsg,
+         NULL, NULL);
+    if (ret && pdwEncodingType)
+        *pdwEncodingType = X509_ASN_ENCODING | PKCS_7_ASN_ENCODING;
+done:
+    free(b64);
+    free(text);
+    return ret;
+}
