#!/usr/bin/env python3
"""Torquio's Dorico launcher. Fix Icons & Refresh Launchers (and the installer) copy it to ~/.local/bin with
this copy of Torquio's folder filled in below; the launcher itself is lib/torquio/launch/."""
import os
import sys

REPO = "@TORQUIO_REPO_DIR@"
if REPO.startswith("@"):  # not installed: running from the repo (scripts/3-runtime_handlers/)
    REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
if sys.version_info < (3, 9):
    sys.exit("Torquio needs Python 3.9 or newer (yours is %d.%d); install a newer python3 package." % sys.version_info[:2])
sys.path.insert(0, os.path.join(REPO, "lib"))

from torquio.launch import main  # noqa: E402

sys.exit(main("dorico", sys.argv))
