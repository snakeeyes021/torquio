#!/usr/bin/env python3
"""Torquio: Steinberg on Linux. Run without arguments for the menu, or `torquio --help-like-flag` for the flag
list (any unknown flag prints it). The code is in lib/torquio/; see docs/ARCHITECTURE.md."""
import os
import sys

# Kept free of newer syntax so that an old Python gets this message rather than a syntax error
if sys.version_info < (3, 9):
    sys.stderr.write("Torquio needs Python 3.9 or newer (yours is %d.%d); install a newer python3 package.\n"
                     % sys.version_info[:2])
    sys.exit(1)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

from torquio.cli.main import main  # noqa: E402

sys.exit(main(sys.argv))
