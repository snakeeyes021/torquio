#!/bin/bash
set -e

# --- Logging Setup ---
TORQUIO_LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/torquio/logs"
mkdir -p "$TORQUIO_LOG_DIR"
(ls -t "$TORQUIO_LOG_DIR"/*.log 2>/dev/null | tail -n +21 | xargs rm -f 2>/dev/null) &
LOG_FILE="$TORQUIO_LOG_DIR/torquio_main_$(date +%Y-%m-%d_%H-%M-%S).log"
exec > >(tee -i "$LOG_FILE") 2>&1
echo "=== Torquio Main Log Started: $(date) ==="
echo "Script: $0"
echo "========================================="

# Torquio: Steinberg on Linux CLI App
# Replaces simple install wrappers with a unified console manager.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/scripts/common.sh"
torquio_require_python

print_header() {
    torquio_py header
}

apply_graphics_settings() {
    torquio_py apply-graphics-settings
}

configure_graphics() {
    torquio_py configure-graphics
}

refresh_launchers() {
    torquio_py refresh-launchers "$@"
}

show_status() {
    torquio_py status
}

map_folder() {
    torquio_py map-folder "$@"
}

manage_folder_mappings() {
    torquio_py manage-folder-mappings
}

export_keycommands() {
    torquio_py export-keycommands
}

update_torquio() {
    # Python applies the update and exits with 100; then this copy hands over to the updated one (exec), so
    # nothing after this line runs from the old script
    local old_head rc=0
    old_head=$(git -C "$SCRIPT_DIR" rev-parse HEAD 2>/dev/null) || true
    torquio_py update-torquio "$@" || rc=$?
    if [ $rc -eq 100 ]; then
        exec "$SCRIPT_DIR/torquio" --post-update "$old_head" "$@"
    fi
    return $rc
}

# Runs from the freshly updated script after update_torquio: refresh launchers and prefix settings, and offer
# a Wine engine rebuild when the update changed the Wine build (patches, build script).
post_update() {
    torquio_py post-update "$@"
}

export_logs() {
    torquio_py export-logs
}

import_keycommands() {
    torquio_py import-keycommands
}

manage_keycommands() {
    torquio_py manage-keycommands
}

run_custom_exe() {
    torquio_py run-custom-exe "$@"
}

# Bring an existing prefix up to date with prefix settings added after it was created (setup_prefix.sh sets
# them on new installs). Run this before the Wine engine changes: the first Wine command after a change updates
# the prefix, and these settings should be in place for that.
#  - Steinberg's plug-in host UI only draws text in "Segoe UI"; alias it to Tahoma.
#  - Keep .NET out of rundll32, so the prefix update doesn't show two "This application could not be
#    started" errors (see setup_prefix.sh).
apply_prefix_settings() {
    torquio_py apply-prefix-settings
}

rebuild_wine() {
    torquio_py rebuild-wine
}

enable_ntsync() {
    torquio_py enable-ntsync
}

# Bring the Wine engine up to date with this copy of Torquio: download the matching prebuilt engine when
# there is one, otherwise offer to compile it.
update_wine_engine() {
    torquio_py update-wine-engine
}

# Switch the container to the machine ID derived from this computer (--quiet: say nothing when it already is)
fix_machine_identity() {
    torquio_py fix-machine-identity "$@"
}

# Make the user's GPUs available to AI plug-ins (safe to re-run). --quiet skips the explanation when
# nothing needs the user's attention.
setup_gpu_access() {
    torquio_py setup-gpu-access "$@"
}

manage_wine() {
    torquio_py manage-wine
}

# Look for a newer Torquio on GitHub, at most once a day and quietly: never longer than a few seconds, no
# password or key prompts, nothing at all when offline or turned off in Settings.
check_for_updates() {
    torquio_py check-for-updates
}

# Updates found by the last check (no network access)
pending_updates() {
    torquio_py pending-updates
}

manage_settings() {
    torquio_py manage-settings
}

show_menu() {
    check_for_updates
    while true; do
        print_header
        echo ""
        
        # Check if environment is active (container exists and core is installed)
        local env_active=false
        if distrobox list 2>/dev/null | grep -q "$TORQUIO_CONTAINER_NAME" && [ -f "$TORQUIO_PREFIX_DIR/.torquio_core_installed" ]; then
            env_active=true
        fi
        
        local wine="\033[38;5;125m"
        local yellow="\033[38;5;179m"
        local reset="\033[0m"

        local updates
        updates=$(pending_updates)
        if [ "${updates:-0}" -gt 0 ]; then
            local update_option=4
            [ "$env_active" = "true" ] && update_option=9
            local changes="$updates changes"
            [ "$updates" -eq 1 ] && changes="1 change"
            echo -e "  ${yellow}Torquio update available ($changes): choose ${update_option}) Update Torquio, or run 'torquio -u'.${reset}"
            echo ""
        fi

        if [ "$env_active" = "true" ]; then
            echo -e "  ${wine}1)${reset} Reinstall/Repair Torquio Environment"
            echo -e "  ${wine}2)${reset} Uninstall/Wipe Torquio"
            echo -e "  ${wine}3)${reset} Status Dashboard"
            echo -e "  ${wine}4)${reset} Configure Graphics & Scaling"
            echo -e "  ${wine}5)${reset} Fix Icons & Refresh Launchers"
            echo -e "  ${wine}6)${reset} Manage Folder Mappings (Map/Unmap)"
            echo -e "  ${wine}7)${reset} Manage Dorico Key Commands"
            echo -e "  ${wine}8)${reset} Wine Tools & Maintenance"
            echo -e "  ${wine}9)${reset} Update Torquio"
            echo -e "  ${wine}10)${reset} Export Logs (for bug reports)"
            echo -e "  ${wine}11)${reset} Settings"
            echo -e "  ${wine}12)${reset} Exit"
            echo ""
            read -p "Select an option (1-12): " choice
            echo ""
            case "$choice" in
                1)
                    if "$SCRIPT_DIR/scripts/install.sh"; then
                        :
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                2)
                    if "$SCRIPT_DIR/scripts/cleanup.sh"; then
                        clear
                        continue
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                3)  show_status ;;
                4)  configure_graphics; clear; continue ;;
                5)  refresh_launchers; clear; continue ;;
                6)  manage_folder_mappings; clear; continue ;;
                7)  manage_keycommands; clear; continue ;;
                8)  manage_wine; clear; continue ;;
                9)  update_torquio --menu || true ;;
                10) export_logs ;;
                11) manage_settings; clear; continue ;;
                12) exit 0 ;;
                *)  echo "Invalid option. Please choose 1-12." ;;
            esac
        else
            echo -e "  ${wine}1)${reset} Install Torquio Environment"
            echo -e "  ${wine}2)${reset} Clean/Remove Torquio"
            echo -e "  ${wine}3)${reset} Status Dashboard"
            echo -e "  ${wine}4)${reset} Update Torquio"
            echo -e "  ${wine}5)${reset} Export Logs (for bug reports)"
            echo -e "  ${wine}6)${reset} Settings"
            echo -e "  ${wine}7)${reset} Exit"
            echo ""
            read -p "Select an option (1-7): " choice
            echo ""
            case "$choice" in
                1)
                    if "$SCRIPT_DIR/scripts/install.sh"; then
                        :
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                2)
                    if "$SCRIPT_DIR/scripts/cleanup.sh"; then
                        clear
                        continue
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                3)  show_status ;;
                4)  update_torquio --menu || true ;;
                5)  export_logs ;;
                6)  manage_settings; clear; continue ;;
                7)  exit 0 ;;
                *)  echo "Invalid option. Please choose 1-7." ;;
            esac
        fi
        
        echo ""
        read -p "Press [Enter] to return to the main menu..." temp
        clear
    done
}

# --- CLI Flag Parsing Mode ---
if [ $# -gt 0 ]; then
    case "$1" in
        -i|--install|--reinstall)
            shift
            "$SCRIPT_DIR/scripts/install.sh" "$@"
            ;;
        -r|--remove|--uninstall)
            shift
            "$SCRIPT_DIR/scripts/cleanup.sh" "$@"
            ;;
        -f|--fix-icons)
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "cd \"$SCRIPT_DIR\" && ./scripts/2-install/extract_icons.sh"
            update-desktop-database "$HOME/.local/share/applications/" >/dev/null 2>&1 || true
            ;;
        -g|--graphics)
            configure_graphics
            ;;
        -s|--status)
            show_status
            ;;
        -u|--update)
            update_torquio
            ;;
        --post-update)
            post_update "$2"
            if [ "$3" = "--menu" ]; then
                echo ""
                read -p "Press [Enter] to return to the main menu..." temp
                clear
                show_menu
            fi
            ;;
        -d|--map_folder)
            map_folder "$2" "$3"
            ;;
        -l|--export-logs|--export_logs)
            export_logs
            ;;
        --manifest)
            torquio_py manifest
            ;;
        -x|--export_key_commands)
            export_keycommands
            ;;
        -m|--import_key_commands)
            import_keycommands
            ;;
        -w|--winecfg)
            ft_int=$(get_config_val "freetype_interpreter" "40")
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; winecfg" || true
            ;;
        -k|--kill_wine)
            echo "Shutting down Wine server..."
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; wineserver -k && wineserver -w" || true
            echo "Wine server shutdown complete."
            ;;
        -b|--reboot)
            echo "Rebooting Wine prefix..."
            ft_int=$(get_config_val "freetype_interpreter" "40")
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; wineboot -r" || true
            echo "Prefix reboot completed."
            ;;
        -e|--execute|--run)
            run_custom_exe "$2"
            ;;
        --rebuild-wine|--rebuild_wine)
            rebuild_wine
            ;;
        --fix-identity|--fix_identity)
            fix_machine_identity
            ;;
        --setup-gpu|--setup_gpu)
            setup_gpu_access
            ;;
        --enable-ntsync|--enable_ntsync)
            enable_ntsync
            ;;
        *)
            torquio_py unknown-argument "$1"
            exit 1
            ;;
    esac
else
    # Interactive menu mode
    clear
    show_menu
fi
