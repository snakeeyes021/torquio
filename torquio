# Bring an existing prefix up to date with prefix settings added after it was created (setup_prefix.sh sets
# them on new installs). Run this before the Wine engine changes: the first Wine command after a change updates
# the prefix, and these settings should be in place for that.
#  - Steinberg's plug-in host UI only draws text in "Segoe UI"; alias it to Tahoma.
#  - Keep .NET out of rundll32, so the prefix update doesn't show two "This application could not be
#    started" errors (see setup_prefix.sh).
apply_prefix_settings() {
    torquio_py apply-prefix-settings
}

rebuild_wine() {
    local wine="\033[38;5;125m"
    local reset="\033[0m"
    local blue="\033[38;5;110m"
    local red="\033[38;5;167m"
    local yellow="\033[38;5;179m"

    if ! distrobox list 2>/dev/null | grep -q "$TORQUIO_CONTAINER_NAME"; then
        echo -e "${red}Error: Container '$TORQUIO_CONTAINER_NAME' does not exist.${reset}"
        echo "Please install or initialize Torquio first."
        return 1
    fi

    echo -e "${blue}=== Rebuilding Wine Engine ===${reset}"
    echo "This will recompile the custom Wine binary inside the container and install it to /opt/wine-custom."
    echo ""

    echo "Terminating any running Wine instances..."
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; wineserver -k 2>/dev/null || true; wineserver -w 2>/dev/null || true"

    apply_prefix_settings
    echo "Running build_wine.sh inside container..."
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "cd \"$SCRIPT_DIR\" && ./scripts/1-build/build_wine.sh --rebuild"

    echo ""
    echo -e "${wine}Wine rebuild complete!${reset}"
}

enable_ntsync() {
    torquio_py enable-ntsync
}

host_has_nvidia() { [ -e /proc/driver/nvidia/version ]; }
container_has_nvidia() { distrobox enter "$TORQUIO_CONTAINER_NAME" -- test -e /usr/lib/x86_64-linux-gnu/libGLX_nvidia.so.0 2>/dev/null; }

# Re-create the Torquio container from IMAGE (an updated prebuilt Wine engine) or, without one, from the image
# it came from: the prebuilt image, or for a locally compiled engine a snapshot of the container itself. The new
# container gets the host's NVIDIA libraries (distrobox --nvidia) when there are any, and is checked before it
# replaces the old one. The Wine prefix lives outside the container and isn't touched.
replace_container() {
    local image="$1"
    local red="\033[38;5;167m"
    local reset="\033[0m"
    local mgr current
    mgr=$(torquio_container_manager)
    current=$(torquio_container_image)
    local new="$TORQUIO_CONTAINER_NAME-new"
    local snapshot=""

    [ -z "$image" ] && [[ "$current" == "$TORQUIO_IMAGE_REPO:"* ]] && image="$current"
    local machine_id
    machine_id=$(container_machine_id)
    echo "Stopping Wine and the container..."
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; wineserver -k 2>/dev/null; wineserver -w 2>/dev/null" || true
    distrobox stop "$TORQUIO_CONTAINER_NAME" --yes >/dev/null 2>&1 || true
    if [ -z "$image" ]; then
        local store="$HOME/.local/share/containers"
        [ -d "$store" ] || store="$HOME"
        # The snapshot needs about as much space as the container (~7 GB) until the old container is removed.
        if [ "$(df -Pk "$store" | awk 'NR == 2 {print $4}')" -lt $((10 * 1024 * 1024)) ]; then
            echo -e "${red}Not enough free disk space (10 GB needed); nothing was changed.${reset}"
            return 1
        fi
        snapshot="localhost/$TORQUIO_CONTAINER_NAME:gpu-$(date +%Y%m%d%H%M%S)"
        echo "Saving the current container..."
        if ! $mgr commit "$TORQUIO_CONTAINER_NAME" "$snapshot" >/dev/null; then
            echo -e "${red}Couldn't save the container; nothing was changed.${reset}"
            return 1
        fi
        image="$snapshot"
    fi
    echo "Creating the new container..."
    local nvidia_flag=""
    host_has_nvidia && nvidia_flag="--nvidia"
    distrobox rm --force "$new" >/dev/null 2>&1 || true
    if ! distrobox create -i "$image" -n "$new" --hostname "$(hostname)" $nvidia_flag --no-entry --yes >/dev/null ||
       ! distrobox enter "$new" -- test -x "$WINE_CUSTOM_BIN/wine"; then
        echo -e "${red}The new container didn't work; your current one is unchanged.${reset}"
        distrobox rm --force "$new" >/dev/null 2>&1 || true
        [ -n "$snapshot" ] && $mgr rmi "$snapshot" >/dev/null 2>&1
        return 1
    fi
    # Keep the computer's identity (Wine's system UUID, which e.g. Cantai's license is tied to)
    if [ ${#machine_id} -eq 32 ]; then
        distrobox enter "$new" -- bash -c "sudo mkdir -p /var/lib/dbus && sudo rm -f /var/lib/dbus/machine-id && echo $machine_id | sudo tee /var/lib/dbus/machine-id >/dev/null"
    fi
    distrobox stop "$new" --yes >/dev/null 2>&1 || true
    distrobox rm --force "$TORQUIO_CONTAINER_NAME" >/dev/null
    $mgr rename "$new" "$TORQUIO_CONTAINER_NAME"
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "cd \"$SCRIPT_DIR\" && ./scripts/1-build/container_gpu_setup.sh" || true
    # Earlier prebuilt engines, and the snapshot the old container was made from (NVIDIA conversion), are no
    # longer needed
    local old
    for old in $($mgr images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep "^$TORQUIO_IMAGE_REPO:"); do
        [ "$old" != "$image" ] && $mgr rmi "$old" >/dev/null 2>&1
    done
    if [[ "$current" == "localhost/$TORQUIO_CONTAINER_NAME:gpu-"* ]] && [ "$current" != "$image" ]; then
        $mgr rmi "$current" >/dev/null 2>&1
    fi
    echo "Container replaced."
}

# Bring the Wine engine up to date with this copy of Torquio: download the matching prebuilt engine when
# there is one, otherwise offer to compile it.
# Whether the Wine engine in the container isn't the one this copy of Torquio builds: a prebuilt image other than
# the matching one, or a locally compiled engine whose build record (zhiyi/wine commit and patches) doesn't match
# this copy's, or that has none (engines compiled before Torquio recorded them).
engine_outdated() {
    local image expected record wanted
    image=$(torquio_container_image)
    if [[ "$image" == "$TORQUIO_IMAGE_REPO:"* ]]; then
        expected=$(torquio_prebuilt_image)
        [ -n "$expected" ] && [ "$image" != "$expected" ]
        return
    fi
    record=$(distrobox enter "$TORQUIO_CONTAINER_NAME" -- cat /opt/wine-custom/share/torquio/build-info </dev/null 2>/dev/null | grep -E '^(zhiyi_commit|patch)=' || true)
    [ -z "$record" ] && return 0
    wanted=$(echo "zhiyi_commit=$(sed -n 's/^TARGET_COMMIT="\(.*\)"$/\1/p' "$SCRIPT_DIR/scripts/1-build/build_wine.sh")"
             for patch in "$SCRIPT_DIR"/scripts/1-build/patches/*.patch; do
                 echo "patch=$(sha256sum "$patch" | cut -c1-12) $(basename "$patch" .patch)"
             done)
    [ "$record" != "$wanted" ]
}

update_wine_engine() {
    local green="\033[38;5;108m"
    local yellow="\033[38;5;179m"
    local reset="\033[0m"
    local image
    image=$(torquio_prebuilt_image)
    apply_prefix_settings
    if [ -n "$image" ]; then
        if [ "$(torquio_container_image)" = "$image" ]; then
            echo -e "${green}Torquio's Wine engine is up to date.${reset}"
            read -p "Compile it from source anyway (20-40 minutes)? [y/N]: " confirm || true
            [[ "$confirm" =~ ^[Yy]$ ]] && rebuild_wine
            return 0
        fi
        echo "Torquio's Wine engine can be downloaded ready-made (a few minutes; Wine and Dorico are closed while the container is replaced)."
        read -p "Download it now? [Y/n]: " confirm || true
        if [[ "$confirm" =~ ^[Nn]$ ]]; then
            echo "You can update it later from Wine Tools & Maintenance > Update / Rebuild Wine Engine."
            return 0
        fi
        if torquio_pull_image "$image"; then
            replace_container "$image"
            return $?
        fi
        echo -e "${yellow}The prebuilt engine for this version of Torquio isn't available yet (it's published within about an hour of each update). You can try again later, or compile it now.${reset}"
    fi
    read -p "Compile the Wine engine now (20-40 minutes)? [y/N]: " confirm || true
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rebuild_wine
    else
        echo "You can update it later from Wine Tools & Maintenance > Update / Rebuild Wine Engine."
    fi
}

container_machine_id() {
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- cat /var/lib/dbus/machine-id </dev/null 2>/dev/null | tr -dc '0-9a-f' || true
}

# Containers created before Torquio derived the machine ID from the host's have one they made up themselves.
# Torquio keeps it whenever it re-creates the container, but if the container is ever lost (deleted outside
# Torquio, or broken) the new one gets the derived ID, and plug-ins tied to the old one (e.g. Cantai) see a new
# computer. Switching to the derived ID once, with those plug-ins deactivated, avoids that.
fix_machine_identity() {
    local blue="\033[38;5;110m"
    local green="\033[38;5;108m"
    local yellow="\033[38;5;179m"
    local reset="\033[0m"
    local current derived plugins
    derived=$(torquio_derived_machine_id)
    current=$(container_machine_id)
    if [ ${#derived} -ne 32 ] || [ ${#current} -ne 32 ]; then
        echo "Couldn't read this computer's identity; nothing was changed."
        return 1
    fi
    if [ "$current" = "$derived" ]; then
        [ "$1" = "--quiet" ] || echo -e "${green}This computer's identity is already stable; nothing to do.${reset}"
        return 0
    fi
    echo -e "${blue}=== Computer Identity ===${reset}"
    echo "Windows programs identify this computer by an ID that Torquio's container made up when it was created."
    echo "Torquio now derives it from your computer instead, so it stays the same even if the container ever has"
    echo "to be created from scratch. Some plug-ins (e.g. Cantai) tie their license to this ID: changing it makes"
    echo "them see a new computer, so deactivate them first and activate them again afterwards. Steinberg"
    echo "licenses aren't affected. It's unlikely to ever matter, but it's worth doing once."
    echo ""
    plugins=$(torquio_py plugin-licenses "$TORQUIO_PREFIX_DIR" 2>/dev/null || true)
    if [ -n "$plugins" ]; then
        echo -e "${yellow}Still activated:${reset}"
        echo ""
        while IFS=$'\t' read -r name where; do
            echo -e "${yellow}$name${reset} (deactivate it $where)"
        done <<< "$plugins"
        echo ""
        echo "Deactivate them, then run 'torquio --fix-identity'."
        return 0
    fi
    read -p "Have you deactivated every plug-in license tied to this computer, and should Torquio change the ID now? [y/N]: " confirm || true
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Nothing was changed. You can do this later with 'torquio --fix-identity'."
        return 0
    fi
    echo "Closing Wine (and Dorico, if it's open)..."
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; wineserver -k 2>/dev/null; wineserver -w 2>/dev/null; sudo rm -f /var/lib/dbus/machine-id; echo $derived | sudo tee /var/lib/dbus/machine-id >/dev/null"
    if [ "$(container_machine_id)" = "$derived" ]; then
        echo -e "${green}Done. Activate your plug-ins again the next time you open Dorico.${reset}"
    else
        echo "Couldn't change the ID; nothing was changed."
        return 1
    fi
}

# Make the user's GPUs available to AI plug-ins (safe to re-run). --quiet skips the explanation when
# nothing needs the user's attention.
setup_gpu_access() {
    local blue="\033[38;5;110m"
    local reset="\033[0m"
    if host_has_nvidia && ! container_has_nvidia; then
        echo -e "${blue}=== GPU Access for AI Plug-ins ===${reset}"
        echo "Your computer has an NVIDIA GPU that Torquio's container can't use yet. Torquio can re-create the"
        echo "container with access to it (a few minutes). Dorico, your settings and your licenses aren't affected."
        echo ""
        read -p "Set up NVIDIA access now? [Y/n]: " confirm || true
        if [[ ! "$confirm" =~ ^[Nn]$ ]]; then
            replace_container || return 1
        fi
    elif [ "$1" != "--quiet" ]; then
        echo -e "${blue}=== GPU Access for AI Plug-ins ===${reset}"
    fi
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "cd \"$SCRIPT_DIR\" && ./scripts/1-build/container_gpu_setup.sh" || true
    "$SCRIPT_DIR/scripts/2-install/install_vkd3d_proton.sh" || true
}

list_vulkan_gpus() { # "type|name" per GPU, without CPU emulations
    distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "vulkaninfo --summary 2>/dev/null" |
        awk -F' = ' '/deviceType/ {t=$2} /deviceName/ {print t "|" $2}' | grep -v '^PHYSICAL_DEVICE_TYPE_CPU'
}

manage_ai_gpu() {
    local wine="\033[38;5;125m"
    local gray="\033[38;5;244m"
    local reset="\033[0m"
    local blue="\033[38;5;110m"
    setup_gpu_access --quiet
    while true; do
        local current gpus
        current=$(get_config_val "ai_gpu" "auto")
        mapfile -t gpus < <(list_vulkan_gpus)
        echo ""
        echo -e "${blue}=== GPU for AI Plug-ins (e.g. Cantai) ===${reset}"
        echo "AI plug-ins run their models on this GPU (changes apply the next time Dorico starts)."
        echo ""
        echo "GPUs found:"
        for g in "${gpus[@]}"; do
            local type="integrated"; [[ "${g%%|*}" == *DISCRETE* ]] && type="dedicated"
            echo -e "  - ${g#*|} ${gray}($type)${reset}"
        done
        [ ${#gpus[@]} -eq 0 ] && echo "  (none)"
        echo ""
        echo -e "Current setting: ${wine}$current${reset}"
        echo ""
        echo -e "  ${wine}1)${reset} Automatic (the strongest GPU)"
        echo -e "  ${wine}2)${reset} Choose a GPU"
        echo -e "  ${wine}3)${reset} Off (AI plug-ins use the CPU)"
        echo -e "  ${wine}4)${reset} [Back]"
        echo ""
        read -p "Select an option (1-4): " opt || true
        case "$opt" in
            1) set_config_val "ai_gpu" "auto" ;;
            2)
                local i=1
                for g in "${gpus[@]}"; do echo -e "  ${wine}$i)${reset} ${g#*|}"; i=$((i + 1)); done
                read -p "GPU (1-${#gpus[@]}): " pick || true
                if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le ${#gpus[@]} ]; then
                    set_config_val "ai_gpu" "${gpus[$((pick - 1))]#*|}"
                fi
                ;;
            3) set_config_val "ai_gpu" "off" ;;
            *) return ;;
        esac
    done
}

manage_wine() {
    local wine="\033[38;5;125m"
    local reset="\033[0m"
    local blue="\033[38;5;110m"

    while true; do
        echo -e "${blue}=== Wine Tools & Maintenance ===${reset}"
        echo ""
        echo -e "  ${wine}1)${reset} Run Wine Configuration (winecfg)"
        echo -e "  ${wine}2)${reset} Run Registry Editor (regedit)"
        echo -e "  ${wine}3)${reset} Run Control Panel (control)"
        echo -e "  ${wine}4)${reset} Run File Manager (explorer)"
        echo -e "  ${wine}5)${reset} Run Command Prompt (cmd)"
        echo -e "  ${wine}6)${reset} Reboot Wine Prefix (wineboot -r)"
        echo -e "  ${wine}7)${reset} Shutdown Wine Server (wineserver -k)"
        echo -e "  ${wine}8)${reset} Monitor XWayland Keyboard Events (xev)"
        echo -e "  ${wine}9)${reset} Run Custom Installer/Executable (.exe/.msi)"
        echo -e "  ${wine}10)${reset} Open C: Drive in Host File Manager"
        echo -e "  ${wine}11)${reset} Enable Kernel Fast Sync (NTsync)"
        echo -e "  ${wine}12)${reset} Update / Rebuild Wine Engine"
        echo -e "  ${wine}13)${reset} GPU for AI Plug-ins (e.g. Cantai)"
        echo -e "  ${wine}14)${reset} [Back to main menu]"
        echo ""
        read -p "Select an option (1-14): " opt_wine
        local ft_int=$(get_config_val "freetype_interpreter" "40")
        local should_prompt=true
        case "$opt_wine" in
            1)
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; winecfg" || true
                ;;
            2)
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; regedit" || true
                ;;
            3)
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; wine control" || true
                ;;
            4)
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; wine explorer" || true
                ;;
            5)
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; wine cmd" || true
                ;;
            6)
                echo "Rebooting Wine prefix..."
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; wineboot -r" || true
                echo "Prefix reboot completed."
                ;;
            7)
                echo "Shutting down Wine server..."
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; wineserver -k && wineserver -w" || true
                echo "Wine server shutdown complete."
                ;;
            8)
                if ! distrobox enter "$TORQUIO_CONTAINER_NAME" -- command -v xev >/dev/null 2>&1; then
                    echo "xev (X11 Event Viewer) is not installed in the container."
                    read -p "Would you like to install it now? [Y/n]: " install_xev
                    if [[ ! "$install_xev" =~ ^[Nn]$ ]]; then
                        echo "Installing x11-utils..."
                        distrobox enter "$TORQUIO_CONTAINER_NAME" -- sudo apt update
                        distrobox enter "$TORQUIO_CONTAINER_NAME" -- sudo apt install -y x11-utils
                    else
                        clear
                        continue
                    fi
                fi
                echo "Launching X11 Event Viewer (xev)..."
                echo "Focus the small white window that appears and press keys to monitor events."
                echo "Press Ctrl+C inside this terminal to exit the monitor."
                distrobox enter "$TORQUIO_CONTAINER_NAME" -- xev -event keyboard || true
                ;;
            9)
                run_custom_exe
                ;;
            10)
                if [ -d "$TORQUIO_PREFIX_DIR/drive_c" ]; then
                    echo "Opening C: Drive in host file manager..."
                    xdg-open "$TORQUIO_PREFIX_DIR/drive_c" >/dev/null 2>&1 &
                    should_prompt=false
                else
                    echo "Error: Wine prefix C: drive does not exist yet."
                fi
                ;;
            11)
                enable_ntsync
                ;;
            12)
                update_wine_engine
                ;;
            13)
                manage_ai_gpu
                should_prompt=false
                ;;
            *)
                return
                ;;
        esac
        if [ "$should_prompt" = "true" ]; then
            echo ""
            read -p "Press [Enter] to continue..." temp_wine
        fi
        clear
    done
}

# Look for a newer Torquio on GitHub, at most once a day and quietly: never longer than a few seconds, no
# password or key prompts, nothing at all when offline or turned off in Settings.
check_for_updates() {
    torquio_py check-for-updates
}

# Updates found by the last check (no network access)
pending_updates() {
    torquio_py pending-updates
}

manage_settings() {
    torquio_py manage-settings
}

show_menu() {
    check_for_updates
    while true; do
        print_header
        echo ""
        
        # Check if environment is active (container exists and core is installed)
        local env_active=false
        if distrobox list 2>/dev/null | grep -q "$TORQUIO_CONTAINER_NAME" && [ -f "$TORQUIO_PREFIX_DIR/.torquio_core_installed" ]; then
            env_active=true
        fi
        
        local wine="\033[38;5;125m"
        local yellow="\033[38;5;179m"
        local reset="\033[0m"

        local updates
        updates=$(pending_updates)
        if [ "${updates:-0}" -gt 0 ]; then
            local update_option=4
            [ "$env_active" = "true" ] && update_option=9
            local changes="$updates changes"
            [ "$updates" -eq 1 ] && changes="1 change"
            echo -e "  ${yellow}Torquio update available ($changes): choose ${update_option}) Update Torquio, or run 'torquio -u'.${reset}"
            echo ""
        fi

        if [ "$env_active" = "true" ]; then
            echo -e "  ${wine}1)${reset} Reinstall/Repair Torquio Environment"
            echo -e "  ${wine}2)${reset} Uninstall/Wipe Torquio"
            echo -e "  ${wine}3)${reset} Status Dashboard"
            echo -e "  ${wine}4)${reset} Configure Graphics & Scaling"
            echo -e "  ${wine}5)${reset} Fix Icons & Refresh Launchers"
            echo -e "  ${wine}6)${reset} Manage Folder Mappings (Map/Unmap)"
            echo -e "  ${wine}7)${reset} Manage Dorico Key Commands"
            echo -e "  ${wine}8)${reset} Wine Tools & Maintenance"
            echo -e "  ${wine}9)${reset} Update Torquio"
            echo -e "  ${wine}10)${reset} Export Logs (for bug reports)"
            echo -e "  ${wine}11)${reset} Settings"
            echo -e "  ${wine}12)${reset} Exit"
            echo ""
            read -p "Select an option (1-12): " choice
            echo ""
            case "$choice" in
                1)
                    if "$SCRIPT_DIR/scripts/install.sh"; then
                        :
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                2)
                    if "$SCRIPT_DIR/scripts/cleanup.sh"; then
                        clear
                        continue
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                3)  show_status ;;
                4)  configure_graphics; clear; continue ;;
                5)  refresh_launchers; clear; continue ;;
                6)  manage_folder_mappings; clear; continue ;;
                7)  manage_keycommands; clear; continue ;;
                8)  manage_wine; clear; continue ;;
                9)  update_torquio --menu || true ;;
                10) export_logs ;;
                11) manage_settings; clear; continue ;;
                12) exit 0 ;;
                *)  echo "Invalid option. Please choose 1-12." ;;
            esac
        else
            echo -e "  ${wine}1)${reset} Install Torquio Environment"
            echo -e "  ${wine}2)${reset} Clean/Remove Torquio"
            echo -e "  ${wine}3)${reset} Status Dashboard"
            echo -e "  ${wine}4)${reset} Update Torquio"
            echo -e "  ${wine}5)${reset} Export Logs (for bug reports)"
            echo -e "  ${wine}6)${reset} Settings"
            echo -e "  ${wine}7)${reset} Exit"
            echo ""
            read -p "Select an option (1-7): " choice
            echo ""
            case "$choice" in
                1)
                    if "$SCRIPT_DIR/scripts/install.sh"; then
                        :
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                2)
                    if "$SCRIPT_DIR/scripts/cleanup.sh"; then
                        clear
                        continue
                    else
                        local rc=$?
                        if [ $rc -eq 10 ]; then
                            echo ""
                            read -p "Press [Enter] to return to the main menu..." temp
                            clear
                            continue
                        else
                            exit $rc
                        fi
                    fi
                    ;;
                3)  show_status ;;
                4)  update_torquio --menu || true ;;
                5)  export_logs ;;
                6)  manage_settings; clear; continue ;;
                7)  exit 0 ;;
                *)  echo "Invalid option. Please choose 1-7." ;;
            esac
        fi
        
        echo ""
        read -p "Press [Enter] to return to the main menu..." temp
        clear
    done
}

# --- CLI Flag Parsing Mode ---
if [ $# -gt 0 ]; then
    case "$1" in
        -i|--install|--reinstall)
            shift
            "$SCRIPT_DIR/scripts/install.sh" "$@"
            ;;
        -r|--remove|--uninstall)
            shift
            "$SCRIPT_DIR/scripts/cleanup.sh" "$@"
            ;;
        -f|--fix-icons)
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "cd \"$SCRIPT_DIR\" && ./scripts/2-install/extract_icons.sh"
            update-desktop-database "$HOME/.local/share/applications/" >/dev/null 2>&1 || true
            ;;
        -g|--graphics)
            configure_graphics
            ;;
        -s|--status)
            show_status
            ;;
        -u|--update)
            update_torquio
            ;;
        --post-update)
            post_update "$2"
            if [ "$3" = "--menu" ]; then
                echo ""
                read -p "Press [Enter] to return to the main menu..." temp
                clear
                show_menu
            fi
            ;;
        -d|--map_folder)
            map_folder "$2" "$3"
            ;;
        -l|--export-logs|--export_logs)
            export_logs
            ;;
        --manifest)
            torquio_py manifest
            ;;
        -x|--export_key_commands)
            export_keycommands
            ;;
        -m|--import_key_commands)
            import_keycommands
            ;;
        -w|--winecfg)
            ft_int=$(get_config_val "freetype_interpreter" "40")
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; winecfg" || true
            ;;
        -k|--kill_wine)
            echo "Shutting down Wine server..."
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; wineserver -k && wineserver -w" || true
            echo "Wine server shutdown complete."
            ;;
        -b|--reboot)
            echo "Rebooting Wine prefix..."
            ft_int=$(get_config_val "freetype_interpreter" "40")
            distrobox enter "$TORQUIO_CONTAINER_NAME" -- bash -c "export WINEPREFIX=\"$TORQUIO_PREFIX_DIR\"; export PATH=\"$WINE_CUSTOM_BIN:\$PATH\"; export FREETYPE_PROPERTIES=\"truetype:interpreter-version=$ft_int\"; wineboot -r" || true
            echo "Prefix reboot completed."
            ;;
        -e|--execute|--run)
            run_custom_exe "$2"
            ;;
        --rebuild-wine|--rebuild_wine)
            rebuild_wine
            ;;
        --fix-identity|--fix_identity)
            fix_machine_identity
            ;;
        --setup-gpu|--setup_gpu)
            setup_gpu_access
            ;;
        --enable-ntsync|--enable_ntsync)
            enable_ntsync
            ;;
        *)
            torquio_py unknown-argument "$1"
            exit 1
            ;;
    esac
else
    # Interactive menu mode
    clear
    show_menu
fi
