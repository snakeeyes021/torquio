update_torquio() {
    local blue="\033[38;5;110m"
    local green="\033[38;5;108m"
    local red="\033[38;5;167m"
    local reset="\033[0m"
    local git=(git -C "$SCRIPT_DIR")

    echo -e "${blue}=== Update Torquio ===${reset}"
    echo ""
    if ! "${git[@]}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo -e "${red}This copy of Torquio can't update itself (it wasn't installed with 'git clone').${reset}"
        echo "Download the latest version from https://github.com/snakeeyes021/torquio instead."
        return 1
    fi
    if ! "${git[@]}" rev-parse --abbrev-ref "@{u}" >/dev/null 2>&1; then
        echo -e "${red}This copy of Torquio isn't following a branch on GitHub, so it can't update itself.${reset}"
        echo "In $SCRIPT_DIR, switch back to the main branch ('git checkout main') and try again."
        return 1
    fi
    echo "Checking for updates..."
    if ! "${git[@]}" fetch --quiet; then
        echo -e "${red}Couldn't reach GitHub. Check your internet connection and try again.${reset}"
        return 1
    fi
    local count
    count=$("${git[@]}" rev-list --count "HEAD..@{u}")
    if [ "$count" -eq 0 ]; then
        echo -e "${green}Torquio is up to date.${reset}"
        return 0
    fi
    if [ -n "$("${git[@]}" status --porcelain --untracked-files=no)" ] || [ "$("${git[@]}" rev-list --count "@{u}..HEAD")" -ne 0 ]; then
        echo -e "${red}Torquio's files have been changed on this computer, so the update can't be applied automatically.${reset}"
        echo "Your changes haven't been touched. In $SCRIPT_DIR, keep or discard them, then run the update again."
        return 1
    fi
    echo ""
    echo "$count update(s) available:"
    "${git[@]}" log --format='  - %s' "HEAD..@{u}" | head -n 20
    [ "$count" -gt 20 ] && echo "  ...and $((count - 20)) more"
    echo ""
    read -p "Install now? [Y/n]: " confirm
    if [[ "$confirm" =~ ^[Nn]$ ]]; then
        echo "Update cancelled."
        return 0
    fi
    local old_head
    old_head=$("${git[@]}" rev-parse HEAD)
    if ! "${git[@]}" merge --ff-only --quiet "@{u}"; then
        echo -e "${red}The update couldn't be applied. Nothing was changed.${reset}"
        return 1
    fi
    echo -e "${green}Torquio updated.${reset}"
    echo ""
    # Finish with the updated copy of this script, which may refresh things the old one doesn't know about.
    exec "$SCRIPT_DIR/torquio" --post-update "$old_head" "$@"
}

# Runs from the freshly updated script after update_torquio: refresh launchers and prefix settings, and offer
# a Wine engine rebuild when the update changed the Wine build (patches, build script).
post_update() {
    local old_head="$1"
    local yellow="\033[38;5;179m"
    local reset="\033[0m"
    local changed
    changed=$(git -C "$SCRIPT_DIR" diff --name-only "$old_head" HEAD 2>/dev/null)

    if distrobox list 2>/dev/null | grep -q "$TORQUIO_CONTAINER_NAME" && [ -f "$TORQUIO_PREFIX_DIR/.torquio_core_installed" ]; then
        refresh_launchers --no-pause
        setup_gpu_access --quiet
        apply_prefix_settings
        fix_machine_identity --quiet
        # Also when the engine was already out of date (e.g. Torquio was updated with git pull, or an earlier
        # offer was declined), not only when this update changed it
        if echo "$changed" | grep -q '^scripts/1-build/' || engine_outdated; then
            echo -e "${yellow}There's a newer version of Torquio's Wine engine. Until it's updated, Dorico keeps running on the current engine.${reset}"
            update_wine_engine
        fi
    else
        echo "Torquio isn't installed yet, so there's nothing else to refresh."
    fi
}

